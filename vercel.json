{
  "version": 2,
  "functions": {
    "api/*.js": {
      "includeFiles": "{data/**,uploads/**}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js?__route=/api/$1" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js?__route=/uploads/$1" }
  ]
}
