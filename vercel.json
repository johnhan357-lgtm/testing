{
  "version": 2,
  "functions": {
    "api/*.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/uploads/sig_(.*)", "destination": "/uploads/signature_ali_faraz_clean.png" },
    { "source": "/uploads/doc_(.*)", "destination": "/uploads/wLb2mwU18B98yhP5HgPkdE365DWUOhgJCl0djEsH.pdf" },
    { "source": "/api/(.*)", "destination": "/api/index.js?__route=/api/$1" }
  ]
}
